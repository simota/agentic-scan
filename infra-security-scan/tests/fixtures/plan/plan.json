{
  "format_version": "1.2",
  "terraform_version": "1.9.0",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_security_group.db",
          "mode": "managed",
          "type": "aws_security_group",
          "name": "db",
          "values": {
            "name": "db",
            "ingress": [
              {"from_port": 5432, "to_port": 5432, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"], "ipv6_cidr_blocks": []}
            ]
          }
        }
      ],
      "child_modules": [
        {
          "address": "module.site",
          "resources": [
            {
              "address": "module.site.aws_s3_bucket_acl.site",
              "mode": "managed",
              "type": "aws_s3_bucket_acl",
              "name": "site",
              "values": {"bucket": "example-site", "acl": "public-read"}
            },
            {
              "address": "module.site.aws_s3_bucket_public_access_block.site",
              "mode": "managed",
              "type": "aws_s3_bucket_public_access_block",
              "name": "site",
              "values": {"bucket": "example-site", "block_public_acls": false, "block_public_policy": false, "ignore_public_acls": false, "restrict_public_buckets": false}
            }
          ]
        }
      ]
    }
  }
}
